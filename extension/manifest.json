{
  "manifest_version": 3,
  "name": "YouTube Tab Parker",
  "version": "1.3.11",
  "description": "Park new YouTube video tabs locally until you select them or click Load video.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "links.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fail_closed",
        "enabled": true,
        "path": "rules/fail-closed.json"
      }
    ]
  },
  "action": {
    "default_title": "YouTube Tab Parker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "parked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://i.ytimg.com; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
  }
}
